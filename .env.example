DATABASE_URL=postgresql://postgres:postgres@localhost:5432/siger_kan
JWT_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://sigerkan.ubl.ac.id

# Optional. Production defaults to true. Set false only for an HTTP development domain.
# AUTH_COOKIE_SECURE=false

# Required in production. Mount this path on persistent private storage.
PRIVATE_UPLOAD_DIR=./storage/private

# Server-only credential for Hugging Face Inference Providers.
# Create a fine-grained token with "Make calls to Inference Providers" permission.
HUGGINGFACE_TOKEN=hf_replace_with_your_token
HUGGINGFACE_MODEL=openai/gpt-oss-120b:cheapest
